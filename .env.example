# claude-master environment template. Copy to .env and fill in real keys.
# NEVER commit .env. CI runs scripts/secret_scan.py to enforce this.
# Budget: DREX_BUDGET_USD caps test spend; the Decision Taker stops paid
# Drex calls at the cap and runs in degraded (rule) mode afterwards.

# --- Decision Taker (NACE Drex) ---
# Get a key at https://console.nace.ai/dashboard/api-keys
NACE_API_KEY=
# Legacy alias still accepted:
# DREX_API_KEY=
DREX_BUDGET_USD=5.0

# --- Gateway free-provider key pools (one account only per provider) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# --- Brain / gateway wiring ---
CLAUDE_BRAIN_DB=
CLAUDE_BRAIN_SOCKET=
BRAIN_API_URL=http://127.0.0.1:7700
ANTHROPIC_BASE_URL=http://localhost:8080
ANTHROPIC_API_KEY=dummy
