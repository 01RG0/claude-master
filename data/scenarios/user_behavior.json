          "key": "expired_key_1",
          "priority": 1
        },
        {
          "key": "valid_key_2",
          "priority": 2
        }
      ]
    },
    "input": {
      "prompt": "Echo 'KEY_ROTATION_SUCCESSFUL'."
    },
    "expected_oracle": {
      "type": "output_oracle",
      "spec": {
        "output_contains": "KEY_ROTATION_SUCCESSFUL"
      }
    },
    "timeout_s": 45,
    "tags": [
      "user-behavior",
      "keys",
      "rotation"
    ]
  },
