    "tier": "smoke",
    "title": "Instantaneous Upstream 500 Outage Fallback",
    "description": "Simulate primary provider returning HTTP 500 error; gateway automatically fails over to secondary route with zero client error.",
    "setup": {
      "mock_upstream_error": {
        "provider": "groq",
        "status": 500
      }
    },
    "input": {
      "prompt": "Create failover_test.txt with 'FAILOVER_SUCCESS'."
    },
    "expected_oracle": {
      "type": "disk_assertion",
      "spec": {
        "files_exist": [
          "failover_test.txt"
        ],
        "file_contains": {
          "failover_test.txt": [
            "FAILOVER_SUCCESS"
          ]
        }
      }
    },
    "timeout_s": 60,
    "tags": [
      "resilience",
      "failover",
      "smoke"
    ]
  },
