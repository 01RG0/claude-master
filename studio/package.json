{
  "name": "claude-master-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Graph visualization studio for claude-master brain",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:buffer": "tsx ../tests/studio/bench-ring-buffer.ts"
  },
  "dependencies": {
    "sigma": "^3.0.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "jsdom": "^24.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
